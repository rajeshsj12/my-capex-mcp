# ====================================================================
# MCP Server Environment Configuration Template
# ====================================================================

# Vercel Deployment Public URL
VERCEL_URL="https://capex-mcp.vercel.app"
MCP_PUBLIC_URL="https://capex-mcp.vercel.app"

# Online Database Tunnel
DATABASE_URL="mysql://root:password@your-tunnel-host.link:port/capex"

# Database Connection Components
DB_HOST="your-tunnel-host.link"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD="password"
DB_NAME="capex"

# Public Access Mode (true/false)
REQUIRE_AUTH=false

# Server Configuration
ENVIRONMENT="production"
DEBUG=false
