# ====================================================================
# MCP Server Environment Configuration
# ====================================================================

# Online Database Connection String (PostgreSQL)
# Get a free database at https://neon.tech or https://supabase.com
# Example Neon URL: postgresql://[user]:[password]@[endpoint]-pooler.[region].neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Master API Key (Fallback for immediate access or bootstrapping)
MASTER_API_KEY="mcp_admin_sec_999"

# Server Environment
ENVIRONMENT="production"
DEBUG=false
