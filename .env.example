# Online Database Connection
DATABASE_URL="mysql://root:password@your-tunnel-host.link:port/capex"

# Database Connection Components
DB_HOST="your-tunnel-host.link"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD="password"
DB_NAME="capex"

# Private Access API Keys (Multi-User)
MASTER_API_KEY="mcp_admin_sec_999"
ALICE_API_KEY="mcp_alice_sec_101"
BOB_API_KEY="mcp_bob_sec_202"

# Server Configuration
ENVIRONMENT="production"
DEBUG=false
